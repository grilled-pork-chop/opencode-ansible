{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "{{ opencode_provider_url }}"
      },
      "models": {
{% for model in opencode_models %}
        "{{ model.name }}": { "name": "{{ model.name }}" }{{ "" if loop.last else "," }}
{% endfor %}
      }
    }
  },
  "model": "local/{{ opencode_default_model }}"
}
